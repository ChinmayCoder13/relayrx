# No variables required for the synthetic, browser-local demo.
# Optional connected sandbox: all five settings are required.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only. Never prefix the service role key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# All three AI copilots use this SERVER-ONLY Gemini key.
# Locally: copy this file to .env.local, add your key, then restart npm run dev.
# Vercel: Project Settings > Environment Variables > GEMINI_API_KEY, then redeploy.
# NEVER name it VITE_GEMINI_API_KEY or put it in frontend source.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: set false to disable anonymous synthetic-demo copilot requests.
DEMO_COPILOT_ENABLED=true
